  "gates": [
    {
      "id": "models-array-vs-record",
      "status": "OPEN — blocks every Cursor report at this snapshot",
      "what": "This plugin emits `models` as an ARRAY of (model, billing_pool) rows. The snapshot's DTO requires `Record<string, ICliAgentModelUsage>` and its validator rejects arrays outright, so every Cursor report would 400 and lose that segment's tokens, cost, code changes and operations together.",
      "why_the_array_exists": "Cursor is the only agent whose ONE model in ONE segment can legitimately have two rows — the seat-covered part and the credits-paid part. A record keyed by model cannot hold both, and flattening to a model-only record would silently drop one billing pool.",
      "closing_evidence": "A deployed backend that accepts a Cursor (model, billing_pool) shape — either a keyed record whose key carries the pool, or an array accepted alongside the existing record for old clients — demonstrated against the target environment with a real authenticated report."
    },
    {
      "id": "cursor-agent-identity",
      "status": "OPEN",
      "what": "resolveBeeziAgent knows claude-code and codex only; an unknown X-Beezi-Agent (including `cursor`) resolves to claude-code, and AnalyticsSource has no cursor member. Cursor usage would be stored as Claude Code usage.",
      "closing_evidence": "Backend support for a cursor agent/source/tool plus the identity routes this plugin calls (/me/cursor/...), verified against the deployed environment."
    },
    {
      "id": "timeline-break-state",
      "status": "SCHEMA-OK, DEPLOYMENT UNVERIFIED",
      "what": "`state` is a bounded string (<=50) and `break` is already a member of CliAgentActivityState at this commit, excluded from activity-breakdown totals. So the schema accepts it; whether the DEPLOYED reader knows it is unverified.",
      "client_position": "The client keeps `break` behind options.allowBreakState, default OFF. Nothing emits it today."
    },
    {
      "id": "timeline-waiting-subtype",
      "status": "SCHEMA-OK, NO PRODUCER",
      "what": "`waiting_subtype` is an optional bounded string and `command_approval` is a known member. The Cursor client can only emit it from a caller-validated permission marker, and nothing on this host produces one yet.",
      "closing_evidence": "A Cursor host signal that identifies a permission/approval wait, captured from a real install."
    },
    {
      "id": "data-lane-proposed-fields",
      "status": "SCHEMA-OK, EMISSION GATED",
      "what": "The fields this lane derives already exist in the snapshot DTO: `claude_md_lines` + `project_instructions_status` for the rules reader, `context_peak_tokens` / `context_final_tokens` / `context_final_model` for the context metrics, and `models[].by_effort` for the effort buckets. There is NO `cursor_version` property at any level.",
      "client_position": "None of them is emitted. The rules metric additionally needs agreement that a Cursor rules count may travel under the legacy `claude_md_lines` name, and the context metrics need the per-generation token semantics confirmed (see test/context-metrics-cursor.test.mjs).",
      "closing_evidence": "Backend owner agreement on the Cursor meaning of `claude_md_lines`, a deployed route that stores the context fields for a Cursor source, and a DTO revision adding a host-version property if one is wanted."
    }
  ],
